{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://billofmaterials.art/schemas/v1/grid/sector.json",
  "title": "billofmaterials - Grid Sector Spec",
  "description": "Schema for B.O.M. Sector Specication",
  "type": "object",
  "required": [
    "apiVersion",
    "kind",
    "metadata"
  ],
  "properties": {
    "apiVersion": {
      "const": "billofmaterials.art/v1",
      "description": "API version of this grid sector schema"
    },
    "kind": {
      "const": "grid/sector",
      "description": "Type of this object"
    },
    "metadata": {
      "type": "object",
      "required": [
        "name",
        "shortName",
        "company",
        "kind",
        "location"
      ],
      "properties": {
        "name": {
          "type": "string",
          "description": "Canonical name of the sector"
        },
        "shortName": {
          "type": "string",
          "description": "Short name / identifier of the sector",
          "minLength": 3,
          "maxLength": 3
        },
        "company": {
          "type": "string",
          "description": "Company or organization responsible for the sector"
        },
        "kind": {
          "type": "string",
          "description": "Type of sector, e.g. facility, installation, cloud",
          "enum": [
            "agency",
            "cloud",
            "facility",
            "installation"
          ]
        },
        "altNames": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "uniqueItems": true,
          "description": "Alternative names for the sector"
        },
        "location": {
          "type": "object",
          "required": [
            "address",
            "city",
            "region",
            "country"
          ],
          "properties": {
            "realName": {
              "type": "string",
              "description": "Real-world name of the location, when different from the B.O.M. referencial"
            },
            "address": {
              "type": "string",
              "description": "Street address of the location"
            },
            "city": {
              "type": "string",
              "description": "City where the sector is located"
            },
            "region": {
              "type": "string",
              "description": "Region where the sector is located"
            },
            "country": {
              "type": "string",
              "description": "Country where the sector is located"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "events": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/event"
      },
      "description": "Chronological events associated with the sector"
    }
  },
  "$defs": {
    "event": {
      "oneOf": [
        {
          "$ref": "#/$defs/eventBuy"
        },
        {
          "$ref": "#/$defs/eventBuild"
        },
        {
          "$ref": "#/$defs/eventActivityStart"
        },
        {
          "$ref": "#/$defs/eventActivityEnd"
        }
      ]
    },
    "eventBuy": {
      "description": "Purchase event",
      "type": "object",
      "required": [
        "kind",
        "date",
        "owner",
        "price"
      ],
      "properties": {
        "kind": {
          "const": "buy",
          "description": "Event type = purchase"
        },
        "date": {
          "type": "string",
          "format": "date",
          "description": "Date of purchase"
        },
        "owner": {
          "type": "string",
          "description": "Owner associated with the purchase"
        },
        "price": {
          "type": "number",
          "description": "Purchase price"
        }
      },
      "additionalProperties": false
    },
    "eventBuild": {
      "description": "Build or construction event",
      "type": "object",
      "required": [
        "kind",
        "date"
      ],
      "properties": {
        "kind": {
          "const": "build",
          "description": "Event type = build"
        },
        "date": {
          "type": "string",
          "format": "date",
          "description": "Date of construction or build event"
        }
      },
      "additionalProperties": false
    },
    "eventActivityStart": {
      "description": "Activity start event",
      "type": "object",
      "required": [
        "kind",
        "date"
      ],
      "properties": {
        "kind": {
          "const": "activityStart",
          "description": "Event type = activity start"
        },
        "date": {
          "type": "string",
          "format": "date",
          "description": "Date when activity started"
        }
      },
      "additionalProperties": false
    },
    "eventActivityEnd": {
      "description": "Activity end event",
      "type": "object",
      "required": [
        "kind",
        "date"
      ],
      "properties": {
        "kind": {
          "const": "activityEnd",
          "description": "Event type = activity end"
        },
        "date": {
          "type": "string",
          "format": "date",
          "description": "Date when activity ended"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
