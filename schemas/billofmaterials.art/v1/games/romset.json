    "dat": {
      "type": "object",
      "description": "A DAT of the romset and its options",
      "allOf": [
        {
          "$ref": "romlibrary.json#/$defs/options"
        }
      ],
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "description": "Name of the DAT, as in the DAT pack"
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "Paths of the sources, relative to sourceRoot or absolute; defaults to the DAT name"
        }
      },
      "unevaluatedProperties": false
    }
  }
}
