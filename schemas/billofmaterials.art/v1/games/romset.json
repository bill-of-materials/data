{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://billofmaterials.art/schemas/v1/games/romset.json",
  "title": "billofmaterials - Games ROM Set",
  "description": "Schema for B.O.M. Games ROM Sets: one system of a ROM library and its DATs",
  "type": "object",
  "allOf": [
    {
      "$ref": "romlibrary.json#/$defs/options"
    }
  ],
  "required": [
    "apiVersion",
    "kind",
    "library",
    "libretroName",
    "dats"
  ],
  "properties": {
    "apiVersion": {
      "type": "string",
      "const": "billofmaterials.art/v1",
      "description": "API version identifier"
    },
    "kind": {
      "type": "string",
      "const": "games/romset",
      "description": "Resource kind"
    },
    "library": {
      "type": "string",
      "description": "Name of the games/romlibrary this romset belongs to"
    },
    "libretroName": {
      "$ref": "#/$defs/libretroName",
      "description": "Name of the system in the libretro database"
    },
    "dats": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/dat"
      },
      "description": "DATs of the system"
    }
  },
  "unevaluatedProperties": false,
  "$defs": {
